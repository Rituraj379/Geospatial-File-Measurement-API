# ============================================================
# Geospatial File Measurement API — Environment Configuration
# ============================================================
# Copy this file to .env and adjust values for your environment.
# Never commit the real .env to version control.

# Application
APP_NAME=Geospatial File Measurement API
APP_VERSION=1.0.0
ENVIRONMENT=development     # development | production

# File upload limits
MAX_FILE_SIZE_MB=50         # Maximum upload size in megabytes
MAX_UNCOMPRESSED_SIZE_MB=200 # Maximum expanded size of a ZIP archive
MAX_ZIP_ENTRIES=10000        # Maximum number of files/directories in a ZIP

# Local storage — where processed file metadata is persisted
DATA_DIR=./data

# Debug mode (set to false in production)
DEBUG=false
